@model MilkStore.Models.Product
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Sửa sản phẩm" : "Thêm sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .form-err {
        font-size: .78rem;
        color: #dc2626;
        margin-top: .25rem;
        display: block;
    }

    .form-ctrl.is-invalid {
        border-color: #dc2626 !important;
    }

    .name-ok {
        font-size: .78rem;
        color: #059669;
        margin-top: .25rem;
    }

    .name-dup {
        font-size: .78rem;
        color: #dc2626;
        margin-top: .25rem;
    }
</style>

<div style="max-width:720px">
    <div class="admin-card">
        <div class="admin-card-header">
            <h5>@(isEdit ? "✏ Sửa sản phẩm" : "+ Thêm sản phẩm mới")</h5>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index"
               class="btn-admin" style="background:#f3e5f5;color:#6a1b9a">← Quay lại</a>
        </div>

        <div style="padding:1.5rem">
            <form asp-area="Admin" asp-controller="Product" asp-action="Save"
                  method="post" enctype="multipart/form-data" id="productForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">

                    <!-- Tên sản phẩm -->
                    <div style="grid-column:1/-1">
                        <label class="form-label">Tên sản phẩm <span style="color:red">*</span></label>
                        <input type="text" name="ProductName" id="productName"
                               value="@Model.ProductName"
                               class="form-ctrl @(ViewData.ModelState["ProductName"]?.Errors.Any() == true ? "is-invalid" : "")"
                               required autocomplete="off"
                               placeholder="VD: Sữa tươi Vinamilk 1L" />
                        <span id="nameStatus"></span>
                        @if (ViewData.ModelState["ProductName"]?.Errors.Any() == true)
                        {
                            <span class="form-err">@ViewData.ModelState["ProductName"]!.Errors[0].ErrorMessage</span>
                        }
                        <div style="font-size:.75rem;color:#94a3b8;margin-top:.2rem">Chỉ dùng chữ, số, khoảng trắng — không dùng ký tự đặc biệt</div>
                    </div>

                    <!-- Danh mục -->
                    <div>
                        <label class="form-label">Danh mục <span style="color:red">*</span></label>
                        <select name="CategoryId" class="form-ctrl" required>
                            <option value="">-- Chọn danh mục --</option>
                            @foreach (var cat in (List<MilkStore.Models.Category>)ViewBag.Categories)
                            {
                                if (Model.CategoryId == cat.Id)
                                {
                                    <option value="@cat.Id" selected>@cat.Name</option>
                                }
                                else
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Thương hiệu -->
                    <div>
                        <label class="form-label">Thương hiệu <span style="color:red">*</span></label>
                        <select name="BrandId" class="form-ctrl" required>
                            <option value="">-- Chọn thương hiệu --</option>
                            @foreach (var brand in (List<MilkStore.Models.Brand>)ViewBag.Brands)
                            {
                                if (Model.BrandId == brand.Id)
                                {
                                    <option value="@brand.Id" selected>@brand.Name</option>
                                }
                                else
                                {
                                    <option value="@brand.Id">@brand.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Giá -->
                    <div>
                        <label class="form-label">Giá (đ) <span style="color:red">*</span></label>
                        <input type="number" name="Price" value="@Model.Price"
                               class="form-ctrl @(ViewData.ModelState["Price"]?.Errors.Any() == true ? "is-invalid" : "")"
                               required min="1" step="1000" placeholder="VD: 50000" />
                        @if (ViewData.ModelState["Price"]?.Errors.Any() == true)
                        {
                            <span class="form-err">@ViewData.ModelState["Price"]!.Errors[0].ErrorMessage</span>
                        }
                    </div>

                    <!-- Tồn kho -->
                    <div>
                        <label class="form-label">Tồn kho</label>
                        <input type="number" name="StockQuantity" value="@Model.StockQuantity"
                               class="form-ctrl @(ViewData.ModelState["StockQuantity"]?.Errors.Any() == true ? "is-invalid" : "")"
                               min="0" placeholder="0" />
                        @if (ViewData.ModelState["StockQuantity"]?.Errors.Any() == true)
                        {
                            <span class="form-err">@ViewData.ModelState["StockQuantity"]!.Errors[0].ErrorMessage</span>
                        }
                    </div>

                    <!-- Hạn sử dụng -->
                    <div>
                        <label class="form-label">Hạn sử dụng</label>
                        <input type="date" name="ExpiryDate"
                               value="@Model.ExpiryDate.ToString("yyyy-MM-dd")"
                               class="form-ctrl" />
                    </div>

                    <!-- Upload ảnh -->
                    <div>
                        <label class="form-label">Upload ảnh</label>
                        <!-- [FIX TC08] Chỉ cho phép file ảnh, chặn .exe và các file nguy hiểm -->
                        <input type="file" name="imageFile" id="imageFile"
                               class="form-ctrl @(ViewData.ModelState["imageFile"]?.Errors.Any() == true ? "is-invalid" : "")"
                               accept=".jpg,.jpeg,.png,.gif,.webp"
                               onchange="validateAndPreview(this)" />
                        @if (ViewData.ModelState["imageFile"]?.Errors.Any() == true)
                        {
                            <span class="form-err">@ViewData.ModelState["imageFile"]!.Errors[0].ErrorMessage</span>
                        }
                        <span id="fileErr" class="form-err" style="display:none"></span>
                        <div style="font-size:.75rem;color:#94a3b8;margin-top:.2rem">Chỉ chấp nhận .jpg .png .gif .webp, tối đa 5MB</div>
                    </div>

                    <!-- Preview ảnh -->
                    <div style="display:flex;align-items:center">
                        <img id="imgPreview"
                             src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/80x80?text=Preview" : Model.ImageUrl)"
                             style="width:80px;height:80px;object-fit:cover;border-radius:8px;border:1px solid #e2e8f0" />
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <input type="hidden" name="ImageUrl" value="@Model.ImageUrl" />
                        }
                    </div>

                    <!-- Mô tả -->
                    <div style="grid-column:1/-1">
                        <label class="form-label">Mô tả</label>
                        <textarea name="Description" class="form-ctrl" rows="3"
                                  placeholder="Mô tả sản phẩm...">@Model.Description</textarea>
                    </div>
                </div>

                <div style="margin-top:1.5rem;display:flex;gap:.75rem">
                    <button type="submit" id="submitBtn" class="btn-admin btn-primary-admin"
                            style="padding:.65rem 1.75rem;font-size:.95rem">
                        @(isEdit ? "✓ Lưu thay đổi" : "+ Thêm sản phẩm")
                    </button>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                       class="btn-admin" style="background:#f3e5f5;color:#6a1b9a;padding:.65rem 1.25rem">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/product-form.js"></script>
    <script>
        initProductForm(@Model.Id);
    </script>
}