@model List<MilkStore.Models.Coupon>
@{
    ViewData["Title"] = "Quản lý mã giảm giá";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var now = (DateTime)ViewBag.Now;
    string StatusLabel(MilkStore.Models.Coupon c) =>
        now < c.StartDate ? "Chờ hiệu lực" :
        now > c.ExpiryDate ? "Hết hạn" :
        (c.MaxUsage.HasValue && c.UsageCount >= c.MaxUsage.Value) ? "Hết lượt" : "Đang hoạt động";
    string StatusClass(MilkStore.Models.Coupon c) =>
        now < c.StartDate ? "badge-pending" :
        now > c.ExpiryDate ? "badge-expired" :
        (c.MaxUsage.HasValue && c.UsageCount >= c.MaxUsage.Value) ? "badge-maxed" : "badge-active";
}

<style>
    .badge-active {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-expired {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-maxed {
        background: #e0e7ff;
        color: #3730a3;
    }

    .status-badge {
        font-size: .75rem;
        font-weight: 600;
        padding: .25rem .6rem;
        border-radius: 20px;
    }

    .action-btn {
        font-size: .8rem;
        padding: .3rem .7rem;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        background: #fff;
        cursor: pointer;
        text-decoration: none;
        color: #374151;
    }

        .action-btn:hover {
            background: #f8fafc;
        }

        .action-btn.danger {
            color: #dc2626;
            border-color: #fca5a5;
        }

            .action-btn.danger:hover {
                background: #fef2f2;
            }

    .filter-bar {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 1rem;
    }

    .filter-pill {
        padding: .35rem .8rem;
        border-radius: 20px;
        font-size: .8rem;
        font-weight: 500;
        border: 1px solid #e2e8f0;
        background: #fff;
        text-decoration: none;
        color: #374151;
    }

        .filter-pill.active, .filter-pill:hover {
            background: #0ea5e9;
            color: #fff;
            border-color: #0ea5e9;
        }

    .flash-success {
        background: #d1fae5;
        color: #065f46;
        padding: .75rem 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .flash-error {
        background: #fee2e2;
        color: #991b1b;
        padding: .75rem 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: .875rem;
    }

    thead th {
        background: #f8fafc;
        padding: .75rem 1rem;
        text-align: left;
        font-weight: 600;
        color: #64748b;
        border-bottom: 2px solid #e2e8f0;
        white-space: nowrap;
    }

    tbody td {
        padding: .75rem 1rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    tbody tr:hover td {
        background: #f8fafc;
    }
</style>

<div class="page-wrap">
    <div class="page-title">Quản lý mã giảm giá</div>
    <div class="page-sub">Tạo, chỉnh sửa và theo dõi mã khuyến mãi</div>

    @if (TempData["Success"] != null)
    {
        <div class="flash-success">✓ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flash-error">✗ @TempData["Error"]</div>
    }

    <div class="filter-bar">
        <form method="get" style="display:flex;gap:.5rem;flex:1;min-width:200px;">
            <input name="search" value="@ViewBag.Search" placeholder="Tìm mã..."
                   style="padding:.4rem .75rem;border:1px solid #e2e8f0;border-radius:8px;font-size:.85rem;width:200px;" />
            <input type="hidden" name="filter" value="@ViewBag.Filter" />
            <button type="submit" class="action-btn">Tìm</button>
        </form>
        <a href="@Url.Action("Index")" class="filter-pill @(ViewBag.Filter == null ? "active" : "")">Tất cả</a>
        <a href="@Url.Action("Index", new { filter = "active", search = ViewBag.Search })" class="filter-pill @(ViewBag.Filter == "active" ? "active" : "")">Đang hoạt động</a>
        <a href="@Url.Action("Index", new { filter = "pending", search = ViewBag.Search })" class="filter-pill @(ViewBag.Filter == "pending" ? "active" : "")">Chờ hiệu lực</a>
        <a href="@Url.Action("Index", new { filter = "expired", search = ViewBag.Search })" class="filter-pill @(ViewBag.Filter == "expired" ? "active" : "")">Hết hạn</a>
        <a asp-action="Create" style="margin-left:auto;"
           class="action-btn" style="background:#0ea5e9;color:#fff;border-color:#0ea5e9;">+ Thêm mã mới</a>
    </div>

    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Loại giảm</th>
                    <th>Giá trị</th>
                    <th>Bắt đầu</th>
                    <th>Hết hạn</th>
                    <th>Lượt dùng</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.Code</strong></td>
                        <td>@(c.DiscountType == "Percent" ? "Theo %" : "Số tiền")</td>
                        <td>@(c.DiscountType == "Percent" ? $"{c.DiscountValue}%" : $"{c.DiscountValue:N0}đ")</td>
                        <td>@c.StartDate.ToString("dd/MM/yyyy")</td>
                        <td>@c.ExpiryDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @c.UsageCount
                            @if (c.MaxUsage.HasValue)
                            {
                                <span style="color:#94a3b8">/ @c.MaxUsage</span>
                            }
                            else
                            {

                                <span style="color:#94a3b8">/ ∞</span>
                            }
                        </td>
                        <td><span class="status-badge @StatusClass(c)">@StatusLabel(c)</span></td>
                        <td style="display:flex;gap:.4rem;">
                            <a href="@Url.Action("Edit", new { id = c.Id })" class="action-btn">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post"
                                  onsubmit="return confirm('Xóa mã @c.Code?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="action-btn danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align:center;color:#94a3b8;padding:2rem;">
                            Chưa có mã giảm giá nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
