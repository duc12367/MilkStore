@{
    ViewData["Title"] = "Xuất báo cáo";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <h1 class="admin-page-title">📊 Xuất báo cáo</h1>
    <p class="admin-page-sub">Tải về file CSV — mở được trong Excel và Google Sheets</p>
</div>

@{
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var monthAgo = DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
}

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;margin-top:1.5rem">

    <!-- Đơn hàng -->
    <div style="background:#fff;border-radius:14px;border:1px solid #e8ecef;padding:1.5rem">
        <h3 style="margin:0 0 .5rem;font-size:1rem">📦 Báo cáo đơn hàng</h3>
        <p style="font-size:.85rem;color:#888;margin-bottom:1rem">Xuất toàn bộ chi tiết đơn theo khoảng thời gian</p>
        <form asp-action="ExportOrders" method="get">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin-bottom:.75rem">
                <div>
                    <label style="font-size:.8rem;color:#555">Từ ngày</label>
                    <input type="date" name="from" value="@monthAgo" class="form-control form-control-sm">
                </div>
                <div>
                    <label style="font-size:.8rem;color:#555">Đến ngày</label>
                    <input type="date" name="to" value="@today" class="form-control form-control-sm">
                </div>
            </div>
            <select name="status" class="form-select form-select-sm" style="margin-bottom:.75rem">
                <option value="">Tất cả trạng thái</option>
                <option value="Pending">Pending</option>
                <option value="Paid">Paid</option>
                <option value="Shipping">Shipping</option>
                <option value="Cancelled">Cancelled</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary w-100">⬇️ Tải về CSV</button>
        </form>
    </div>

    <!-- Doanh thu theo ngày -->
    <div style="background:#fff;border-radius:14px;border:1px solid #e8ecef;padding:1.5rem">
        <h3 style="margin:0 0 .5rem;font-size:1rem">💰 Doanh thu theo ngày</h3>
        <p style="font-size:.85rem;color:#888;margin-bottom:1rem">Tổng hợp doanh thu mỗi ngày (chỉ đơn Paid/Shipping)</p>
        <form asp-action="ExportRevenue" method="get">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin-bottom:.75rem">
                <div>
                    <label style="font-size:.8rem;color:#555">Từ ngày</label>
                    <input type="date" name="from" value="@monthAgo" class="form-control form-control-sm">
                </div>
                <div>
                    <label style="font-size:.8rem;color:#555">Đến ngày</label>
                    <input type="date" name="to" value="@today" class="form-control form-control-sm">
                </div>
            </div>
            <button type="submit" class="btn btn-sm btn-success w-100">⬇️ Tải về CSV</button>
        </form>
    </div>

    <!-- Sản phẩm bán chạy -->
    <div style="background:#fff;border-radius:14px;border:1px solid #e8ecef;padding:1.5rem">
        <h3 style="margin:0 0 .5rem;font-size:1rem">🏆 Sản phẩm bán chạy</h3>
        <p style="font-size:.85rem;color:#888;margin-bottom:1rem">Top sản phẩm theo số lượng bán trong kỳ</p>
        <form asp-action="ExportProducts" method="get">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin-bottom:.75rem">
                <div>
                    <label style="font-size:.8rem;color:#555">Từ ngày</label>
                    <input type="date" name="from" value="@monthAgo" class="form-control form-control-sm">
                </div>
                <div>
                    <label style="font-size:.8rem;color:#555">Đến ngày</label>
                    <input type="date" name="to" value="@today" class="form-control form-control-sm">
                </div>
            </div>
            <button type="submit" class="btn btn-sm btn-warning w-100">⬇️ Tải về CSV</button>
        </form>
    </div>
</div>
